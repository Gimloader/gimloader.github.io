{
    "plugin": [
        "typedoc-plugin-merge-modules",
        "typedoc-plugin-markdown",
        "./scripts/docs-plugin.ts"
    ],
    "out": "./src/content/docs/api",
    "entryPoints": [
        "./gimloader-source/src/content/api/*.ts"
    ],
    "entryFileName": "index",
    "readme": "none",
    "tsconfig": "./gimloader-source/tsconfig.json",
    "hidePageHeader": true,
    "hideBreadcrumbs": true,
    "disableSources": true,
    "router": "structure",
    "parametersFormat": "table",
    "excludeExternals": true,
    "publicPath": "/api"
}